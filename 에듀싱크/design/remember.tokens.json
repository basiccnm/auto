{
  "color": {
    "action-black": {
      "$type": "color",
      "$value": "#000000"
    },
    "corporate-orange": {
      "$type": "color",
      "$value": "#fc5d11"
    },
    "foreground": {
      "$type": "color",
      "$value": "#222222"
    },
    "hairline": {
      "$type": "color",
      "$value": "#d4d4d4"
    },
    "input-surface": {
      "$type": "color",
      "$value": "#f2f2f2"
    },
    "muted": {
      "$type": "color",
      "$value": "#808080"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    }
  },
  "typography": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": "Pretendard"
      }
    },
    "tiers": {
      "body": {
        "lineHeight": {
          "$type": "number",
          "$value": 1.45
        },
        "size": {
          "$type": "dimension",
          "$value": "16px"
        },
        "use": {
          "$type": "string",
          "$value": "Repeated career posting text and controls"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 400
        }
      },
      "card-title": {
        "lineHeight": {
          "$type": "number",
          "$value": 1.45
        },
        "size": {
          "$type": "dimension",
          "$value": "16px"
        },
        "use": {
          "$type": "string",
          "$value": "Career posting card title"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 400
        }
      },
      "heading": {
        "lineHeight": {
          "$type": "number",
          "$value": 1.3
        },
        "size": {
          "$type": "dimension",
          "$value": "20px"
        },
        "use": {
          "$type": "string",
          "$value": "Career posting section heading"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 600
        }
      }
    }
  },
  "spacing": {
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "radius": {
    "lg": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "shadow": {},
  "$extensions": {
    "oh-my-design": {
      "components": {
        "career-job-list-item": {
          "fg": "#222222",
          "font": "16px/400 Pretendard",
          "radius": "0px",
          "type": "listItem",
          "use": "Chromeless job-list item at career-postings::li; 162px-wide representative capture"
        },
        "career-outline-dialog-button": {
          "bg": "transparent",
          "border": "1px solid #ffffff",
          "fg": "#ffffff",
          "font": "14px/400 Pretendard",
          "padding": "0px 12px",
          "radius": "6px",
          "states": "dialog-open observed from this trigger only",
          "type": "button",
          "use": "Career postings header control at career-postings::[data-omd-capture=10]"
        }
      }
    }
  }
}
