          "type": "input",
          "use": "Help language-picker search field"
        },
        "marketing-primary-action": {
          "bg": "#0075de",
          "fg": "#ffffff",
          "font": "16px/500 NotionInter",
          "height": 36,
          "padding": "4px 14px",
          "radius": 8,
          "states": "hover/pressed/focus captured on marketing; values remain selector-specific",
          "type": "button",
          "use": "Global marketing CTA"
        }
      }
    }
