<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 배경 — 앱 카드와 같은 흰 둥근 상자. 런처 배경이 어두울 수도 밝을 수도 있어
     투명 대신 불투명 카드를 쓴다(글자가 항상 읽힌다). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/w_card" />
    <corners android:radius="@dimen/w_radius" />
    <stroke android:width="1dp" android:color="@color/w_line" />
</shape>
