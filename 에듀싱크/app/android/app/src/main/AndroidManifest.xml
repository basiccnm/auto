<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 소셜 로그인 되돌아오는 길 (2026-08-14).
                 서버 콜백이 인증을 끝내고 eduthink://auth?token=… 으로 앱을 다시 부른다.
                 ⚠ launchMode="singleTask" 라 앱이 새로 뜨지 않고 살아 있는 화면으로 들어온다
                    → app.js 의 appUrlOpen 리스너가 받는다.
                 ⚠ 이 스킴을 바꾸면 카카오·구글·네이버 콘솔의 리디렉션 URI 도 같이 바꿔야 한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eduthink" android:host="auth" />
            </intent-filter>

        </activity>

        <!-- FCM이 만들어 쓰는 기본 채널을 우리 채널로 바꾼다(2026-07-25).
             안 바꾸면 importance 기본(3)짜리 fcm_fallback_notification_channel로 들어가
             알림줄에만 쌓이고 화면 위로 안 튄다. 채널 자체는 app.js에서 만든다(importance 5).
             ⚠ 채널은 한 번 만들어지면 importance를 못 바꾼다 — 값을 바꾸려면 id를 새로 파야 한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="eduthink_urgent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 바탕화면 위젯 (2026-07-27) — 오늘 급식·시간표·내일 준비물.
             exported="true" 여야 런처가 붙일 수 있다. 우리 값을 내보내는 게 아니라
             런처가 그리는 화면일 뿐이라 노출 위험은 없다. -->
        <receiver
            android:name=".SchoolWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 위젯에서 준비물을 눌렀을 때 자기 자신에게 오는 방송(2026-07-27).
                     우리 앱 안에서만 오가고 exported 로 열지 않는다. -->
                <action android:name="com.eduthink.app.TOGGLE_SUPPLY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_school_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/camera — 촬영 + 앨범(2026-07-24). READ_MEDIA_IMAGES는 안드13+, 그 아래는 READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- FCM 푸시 — 안드13+는 런타임 알림 권한이 필요하다(2026-07-24) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
