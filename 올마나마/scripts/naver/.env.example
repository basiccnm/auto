# 네이버 개발자센터(https://developers.naver.com) 앱 등록 후 발급받은 값
# 이 파일을 .env 로 복사해서 채울 것. .env 는 절대 커밋하지 않는다.
#
# ⚠️ 프로젝트마다 앱을 따로 만들 것 — 일일 한도가 앱 단위라 키를 공유하면 한쪽이 조용히 죽는다.
# ⚠️ 이 앱에 '네이버 로그인'을 추가하지 말 것 — 검색 API가 막힌 사례가 있다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택 — 기본값으로 충분하면 비워둬도 된다
# NAVER_HTTP_TIMEOUT=15
# NAVER_CALL_INTERVAL=0.5
