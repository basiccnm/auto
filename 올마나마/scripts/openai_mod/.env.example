# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
# (PowerShell 환경변수로 넣어도 됨: setx OPENAI_API_KEY "sk-...")

OPENAI_API_KEY=sk-여기에_새_키

# 모델 — list_models()로 계정에서 실제 쓸 수 있는 이름을 확인한 뒤 채울 것
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-1

# 레시피는 분량 정확도가 생명 → 낮게 유지
OPENAI_TEMPERATURE=0.35
OPENAI_MAX_TOKENS=2500
OPENAI_TIMEOUT=180
